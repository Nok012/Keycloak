pipeline{
    agent any
    parameters{
        string(name: 'GitLabBranchURL', defaultValue: 'https://gitlab.larry-cctv.com/tools/key-cloak.git', description: 'Enter GitLab repo URL')
        string(name: 'CredentialGitlabID', defaultValue: 'gitlab-surachai', description: 'Enter GitLab credential ID') 
        string(name: 'BRANCH', defaultValue: 'feature/1.0.2026-03', description: 'Branch to build for RabbitMQ service')
        string(name: 'ServerHost', defaultValue: '10.0.10.55', description: 'Server IP')
        string(name: 'CredentialSSHServerID', defaultValue: 'ssh-password-for-dev-server-55', description: 'Credential ID')
        
        text(name: 'ENV_VARS',  defaultValue: '''KC_DB_URL=jdbc:postgresql://<DBHOST>:5432/<DBNAME>
KC_DB_USERNAME=<DBUSERNAME>
KC_DB_PASSWORD=<DBPASSWORD>
KC_HOSTNAME=localhost
KC_BOOTSTRAP_ADMIN_USERNAME=<ADMINUSERNAME>
KC_BOOTSTRAP_ADMIN_PASSWORD=<ADMINPASSWORD>
PORT=<PORTNUMBER>''',
 description: 'Lines of KEY=VALUE to write into .env on the remote')
        string(name: 'KEYCLOAK_CONTAINER_NAME', defaultValue: 'keycloak', description: 'Container name for Keycloak')
        string(name: 'DEPLOY_DIR', defaultValue: 'KeyCloak', description: 'Remote base directory to clone the project into (relative to $HOME, or absolute if starts with /)')
           }
    stages{
        stage("Validate Parameters"){
            steps{
                script{
                    if(!params.GitLabBranchURL?.trim()){
                        error "GitLabBranchURL is required"
                    }
                    if(!params.CredentialGitlabID?.trim()){
                        error "CredentialGitlabID is required"
                    }
                    if(!params.BRANCH?.trim()){
                        error "BRANCH is required"
                    }
                    if(!params.ServerHost?.trim()){
                        error "ServerHost is required"
                    }
                    if(!params.CredentialSSHServerID?.trim()){
                        error "CredentialSSHServerID is required"
                    }
                    if(!params.ENV_VARS?.trim()){
                        error "ENV_VARS is required"
                    }
                    if(!params.DEPLOY_DIR?.trim()){
                        error "DEPLOY_DIR is required"
                    }
                }
            }
        }
        stage("Deploy KeyCloak Service"){
           steps{
            script{
                def envText = params.ENV_VARS.trim() + "\n"
                envText += "KEYCLOAK_CONTAINER_NAME=${params.KEYCLOAK_CONTAINER_NAME?.trim() ?: 'keycloak'}\n"
                writeFile file: 'generated.env', text: envText
            }
            script{
                def sshCredential =params.CredentialSSHServerID
                def serverHost =params.ServerHost
                def remote=[:]
                remote.name= "${serverHost}-server"
                remote.host= "${serverHost}"
                remote.allowAnyHosts= true
                 withCredentials([usernamePassword(credentialsId: params.CredentialGitlabID, usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                        def gitUrlAuth = params.GitLabBranchURL.replaceFirst('https://', "https://${GIT_USER}:${GIT_PASS}@")

                        withCredentials([usernamePassword(credentialsId: sshCredential, usernameVariable: 'SSH_USER', passwordVariable: 'SSH_PASS')]) {
                            remote.user = SSH_USER
                            remote.password = SSH_PASS

                            // Ensure project dir exists and is the latest from git
                            def deployDir = params.DEPLOY_DIR?.trim()
                            // If DEPLOY_DIR is absolute (starts with '/'), use it as-is; otherwise build under $HOME
                            def home = sshCommand(remote: remote, command: 'echo $HOME', returnStdout: true).trim()
                            def remoteBase = deployDir.startsWith('/') ? "${deployDir}" : (home + '/' + deployDir + '/')                            
                            def remoteCmd = """
                            set -e
                            mkdir -p ${remoteBase}
                            cd ${remoteBase}
                            if [ -d .git ]; then
                              echo "Updating repo..."
                              git fetch --all
                              git reset --hard origin/${params.BRANCH}
                              git remote set-url origin ${params.GitLabBranchURL}
                            else
                              echo "Cloning repo..."
                              git clone --branch ${params.BRANCH} ${gitUrlAuth} .
                              git remote set-url origin ${params.GitLabBranchURL}
                            fi
                            """
                            sshCommand remote: remote, command: remoteCmd

                            // upload .env file from agent to remote
                            sshPut remote: remote, from: 'generated.env', into: "${remoteBase}/.env"

                            // start compose
                            def composeCmd = "cd ${remoteBase} && docker compose -f docker-compose.yml up -d"
                            sshCommand remote: remote, command: composeCmd

                        }
                    }
            }
           }
        }
        stage('Verify Container') {
            steps {
                script {
                    def sshCredential = params.CredentialSSHServerID
                    def serverHost = params.ServerHost
                    def remote = [:]
                    remote.name = "${serverHost}-server"
                    remote.host = serverHost
                    remote.allowAnyHosts = true
                    withCredentials([usernamePassword(credentialsId: sshCredential, usernameVariable: 'SSH_USER', passwordVariable: 'SSH_PASS')]) {
                        remote.user = SSH_USER
                        remote.password = SSH_PASS
                        def containerName = params.KEYCLOAK_CONTAINER_NAME?.trim() ?: 'keycloak'
                        def verifyCmd = "docker ps --filter name=${containerName} -a --format '{{.Names}}\t{{.Status}}' || true"
                        sshCommand remote: remote, command: verifyCmd
                    }
                }
            }
        }
    }
      post {
        cleanup {
            script {
                if (isUnix()) {
                    sh "rm -f generated-docker-compose.yml generated.env || true"
                } else {
                    bat "del /f generated-docker-compose.yml generated.env || exit 0"
                }
            }
        }
    }
}